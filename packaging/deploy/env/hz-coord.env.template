# 初始形态：不含 --oidc-*（OIDC 发现文档在 serve 启动时同步获取且仅在
# Kanidm 建好 OAuth2 客户端后才存在，见 crates/hz-coord/src/service.rs 的
# OidcClient::discover）。kanidm-init.sh 完成后会把 --oidc-* 连同 client
# secret 追加进本行并重启 hz-coord。
HZ_COORD_ARGS=--db /var/lib/hz-coord/hznet.db --listen 127.0.0.1:50051 --http-listen 127.0.0.1:8080 --metrics-listen 127.0.0.1:9100 --login-node-ttl-days 90 --dist-dir /var/lib/hz-coord/dist --public-url https://coord.@DOMAIN@ --public-grpc-addr https://coord.@DOMAIN@
