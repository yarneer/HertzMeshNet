# 场景 dns（#19 / FR-5）：两个 LAN Node 注册互见后，验证本地 DNS 应答
# 的字面地址（A/AAAA）、非 HzNet 域名 REFUSED、hzd 停止即停答与重启恢复。
# 系统级 resolver 接管/还原（systemd-resolved、resolv.conf）仍由
# scripts/test/dns_docker.sh 覆盖——拓扑 netns 内无系统解析链路可还原。
HZ_NODES="a:lan b:lan"
HZ_ASSERT="dns"
HZ_COORD="1"
HZ_REFLECTOR="0"
HZ_PROXY_SIM="0"
HZ_WG_PORT="51820"
