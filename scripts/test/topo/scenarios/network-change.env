# 场景 network-change（issue #9）：两锥形 NAT 建立直连后，用 netmove.sh 更换
# fullcone 侧 Node 的上游出口（NAT 换 WAN IP + 新静态映射 + 网卡改名），断言：
# 旧路径确实断开、30 秒内恢复连通（计时打印）、STUN Endpoint 更换、
# 之后再次升级 Direct Path（双方仍在不同 NAT 后，走真实 NAT 穿越）。
HZ_NODES="a:fullcone b:portrestricted"
HZ_ASSERT="netchange"
HZ_COORD="1"
HZ_RELAY="1"
HZ_REFLECTOR="0"
HZ_PROXY_SIM="0"
HZ_WG_PORT="51820"
