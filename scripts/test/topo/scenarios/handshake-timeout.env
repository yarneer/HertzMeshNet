# 场景 handshake-timeout（#75）：锥形直连建立后在 b 的 NAT 丢弃 WG 端口入方向
#（模拟云主机安全组未放行 UDP），对端 Health Report 判 handshake_timeout、
# coord 指标按原因计数；撤销后 30-60 秒内恢复 Direct Path
HZ_NODES="a:fullcone b:portrestricted"
HZ_ASSERT="handshaketimeout"
HZ_COORD="1"
HZ_RELAY="1"
HZ_REFLECTOR="0"
HZ_PROXY_SIM="0"
HZ_WG_PORT="51820"
