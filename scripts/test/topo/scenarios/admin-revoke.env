# 场景 admin-revoke：ticket #12 Admin 远程管理（FR-11 / A3）。
# 三个 lan 节点：a（alice 名下；alice 由 bootstrap --admin 种为 Admin）、
# b（bob 名下普通 User）、d（tag db 的无主 Node）。
# 组合断言：a 可签发 Auth Key，b/d 签发被拒；a 吊销 b 后 5 秒内 b 从
# a/d 的 Network Map 消失、ping 不通，b 的 hz status 显示已吊销；
# 改名冲突被拒，改成新名后对端 Map 与本地 DNS 应答跟随新名。
HZ_NODES="a:lan b:lan d:lan"
HZ_ASSERT="admin_revoke"
HZ_COORD="1"
HZ_RELAY="0"
HZ_REFLECTOR="0"
HZ_PROXY_SIM="0"
HZ_WG_PORT="51820"
