# 场景 relay-ratelimit：双对称 NAT 强制 Relayed Path，Relay 限速 2 Mbps（issue #15 Seam A）。
# export 使 start_relay 拉起的 hz-relay 继承该值（--rate-limit-mbps 的环境变量回退），
# 其余进程不读取此变量，不受影响。
HZ_NODES="a:symmetric b:symmetric"
HZ_ASSERT="ratelimit"
HZ_COORD="1"
HZ_RELAY="1"
HZ_REFLECTOR="0"
HZ_PROXY_SIM="0"
HZ_WG_PORT="51820"
HZ_ISOLATE_LANPEERS="1"
export HZ_RELAY_RATE_MBPS="2"
